\documentclass[tikz,border=6pt]{standalone}
\usepackage{amsmath}
\usetikzlibrary{arrows.meta,calc,decorations.pathreplacing,shadings}

% Per-pulse filtering: each pulse k in the current output block gets its own filter,
% built from the PSD interpolated at its start position alpha_k = pos_k / N2.
\begin{document}
\begin{tikzpicture}[x=1cm, y=1cm, >={Stealth[length=2.2mm]}]

    % ---------------- PSD interpolation bar ----------------
    \shade[left color=blue!35, right color=red!35] (0, 2.4) rectangle (6, 3.0);
    \draw (0, 2.4) rectangle (6, 3.0);
    \node[left, font=\small]  at (0, 2.7) {$P_{j-1}$};
    \node[right, font=\small] at (6, 2.7) {$P_j$};
    \node[above, font=\small] at (3, 3.0) {$P_k = (1-\alpha_k)\,P_{j-1} + \alpha_k\,P_j$};

    % ---------------- pulse buffer ----------------
    \fill[green!6]  (0, -1.2) rectangle (6, 1.2);
    \fill[black!3]  (6, -1.2) rectangle (12, 1.2);
    \draw (0, -1.2) rectangle (12, 1.2);
    \draw[dashed] (6, -1.2) -- (6, 1.2);
    \draw[->] (-0.3, 0) -- (12.5, 0) node[right] {$n$};
    \node[font=\small, below] at (3, -1.2) {output block (512 samples)};
    \node[font=\small, below] at (9, -1.2) {next block};
    \draw[decorate, decoration={brace, mirror, amplitude=5pt}]
        (0, -1.8) -- (12, -1.8) node[midway, below=6pt, font=\small] {\texttt{pulseBuffer}};

    % ---------------- filtered pulses, one filter each ----------------
    \foreach \x/\a/\c/\k in {0.3/0.05/blue/1, 2.1/0.35/violet/2, 3.9/0.65/purple/3, 5.7/0.95/red/4} {
        \draw[thick, \c!80!black, domain=0:3.2, samples=150, smooth, variable=\t]
            plot ({\x + \t}, {0.95 * exp(-1.4 * \t) * sin(deg(10 * \t))});
        \draw[dashed, \c!70!black] (\x, 1.2) -- (\x, 2.4);
        \node[font=\footnotesize, fill=white, inner sep=1pt] at (\x, 1.8) {$\alpha_{\k}$};
        \node[font=\footnotesize, \c!80!black, below right] at (\x, -0.35) {$H_{\k}(z)$};
    }

    % ---------------- carry-over to the next block ----------------
    \draw[->, thick] (6.6, 0.85) -- node[below, font=\footnotesize] {ring-out + next pulse start carry over} (10.6, 0.85);
    \node[font=\footnotesize, align=left, anchor=west] at (12.6, 0.8)
        {$\alpha_k = \dfrac{\texttt{lastPulsePos}}{N_2}$};

\end{tikzpicture}
\end{document}
