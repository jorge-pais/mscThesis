  langid = {english},
  keywords = {Acoustics,Analytical models,Data models,Frequency-domain analysis,Glottal source modelling,Harmonic analysis,Mathematical model,Microphones,Normalized Relative Delays},
  file = {/home/jorgep/Zotero/storage/9GQG2IVH/Dias and Ferreira - 2013 - A hybrid LF-Rosenberg frequency-domain model of th.pdf}
